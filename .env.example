# ---------------------------------------------------------------------------
# PriceNova environment. Placeholders only — never commit real values.
# Copy to .env locally; on Vercel set them under Settings -> Environment
# Variables. Anything without a NEXT_PUBLIC_ prefix stays server-side.
# ---------------------------------------------------------------------------

# Required ------------------------------------------------------------------
# Supabase pooler. Percent-encode the password. Do NOT add ?sslmode=… — TLS is
# configured in code against the pinned CA below.
#   Vercel / production: TRANSACTION pooler, port 6543 (serverless-safe).
#   Local + `npm run db:push`: SESSION pooler, port 5432.
DATABASE_URL="postgresql://postgres.<ref>:<url-encoded-password>@aws-1-<region>.pooler.supabase.com:6543/postgres"
# Connections per server instance (default 3 in production, 10 locally).
# DATABASE_POOL_MAX="3"
# Supabase's private CA (PEM or base64). Production refuses to serve without it.
SUPABASE_CA_CERT=""
# 48+ random bytes: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
# Public origin, no trailing slash. Production refuses to build links without it.
APP_URL="https://your-domain.example"

NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Bypasses Row Level Security. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=""

# Email — Gmail SMTP (or any SMTP server). Without SMTP_USER/SMTP_PASS,
# verification and password-reset emails are refused in production, not faked.
# SMTP_PASS is a Google App Password (16 characters), NOT the Gmail password:
# Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_USER=""                       # e.g. pricenova.support@gmail.com
SMTP_PASS=""
# SMTP_HOST="smtp.gmail.com"       # default
# SMTP_PORT="465"                  # default
# EMAIL_FROM="PriceNova <pricenova.support@gmail.com>"

# Phone verification codes over WhatsApp (Meta WhatsApp Cloud API). Needs an
# approved AUTHENTICATION template with a "Copy code" button.
WHATSAPP_ACCESS_TOKEN=""           # permanent System User token
WHATSAPP_PHONE_NUMBER_ID=""        # from WhatsApp Manager -> API setup
WHATSAPP_OTP_TEMPLATE=""           # template name, e.g. pricenova_otp
# WHATSAPP_OTP_LANGUAGE="en_US"    # the template's language code

# Escape hatch for the TLS guard. Leave unset in production.
# ALLOW_UNVERIFIED_TLS="false"

# ---------------------------------------------------------------------------
# Payments.
#
# Manual USDT (BEP20) needs NO variables: the receiving wallet, QR code and
# instructions are configured by an admin under Admin -> Payment settings
# (/admin/payment-accounts) and stored in the database, and every payment is
# approved by an admin. A future Cryptomus integration will add its own
# variables here.
#
# Every automated provider below is OFF until its variables are set; an unconfigured
# provider refuses to create a charge and is shown as unavailable at checkout.
# Nothing here is ever exposed to the browser (no NEXT_PUBLIC_ prefix).
# ---------------------------------------------------------------------------

# JazzCash Mobile Wallet — https://sandbox.jazzcash.com.pk
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
JAZZCASH_MODE="sandbox"            # sandbox | production

# Easypaisa hosted checkout
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
EASYPAISA_ACCOUNT_NUMBER=""
EASYPAISA_MODE="sandbox"           # sandbox | production

# Card — Stripe-compatible hosted Checkout. PriceNova never touches card data.
CARD_PROVIDER_SECRET_KEY=""
CARD_PROVIDER_WEBHOOK_SECRET=""
CARD_PROVIDER_API_BASE="https://api.stripe.com/v1"
CARD_PROVIDER_MODE="sandbox"       # sandbox | production

# Crypto — NOWPayments-compatible gateway (BTC, USDT TRC20/ERC20).
# The gateway holds the keys and watches the chains. PriceNova holds none.
CRYPTO_PROVIDER_API_KEY=""
CRYPTO_PROVIDER_IPN_SECRET=""
CRYPTO_PROVIDER_API_BASE="https://api.nowpayments.io/v1"
CRYPTO_PROVIDER_MODE="sandbox"     # sandbox | production

# Confirmation targets. Operator policy; defaults are BTC 2, USDT 12.
CRYPTO_CONFIRMATIONS_BTC="2"
CRYPTO_CONFIRMATIONS_USDT_TRC20="12"
CRYPTO_CONFIRMATIONS_USDT_ERC20="12"
CRYPTO_CONFIRMATIONS_USDT_BEP20="12"

# How far under the asked-for amount still credits, in minor units (cents).
# 0 means an exact amount is required.
PAYMENT_UNDERPAY_TOLERANCE_MINOR="0"

# Optional transaction-inquiry endpoints. Left blank on purpose: whether a
# merchant gets a lookup API — and at what URL — depends on the agreement the
# provider grants. Without these, payments go to manual review rather than
# being verified against an invented endpoint.
JAZZCASH_INQUIRY_URL=""
EASYPAISA_INQUIRY_URL=""

