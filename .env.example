DATABASE_URL="postgresql://postgres.<ref>:<url-encoded-password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
AUTH_SECRET=""
APP_URL="http://localhost:3000"
EMAIL_PROVIDER_KEY=""
SMS_PROVIDER_KEY=""

# ---------------------------------------------------------------------------
# Payments. Every provider is OFF until its variables are set; an unconfigured
# provider refuses to create a charge and is shown as unavailable at checkout.
# Nothing here is ever exposed to the browser (no NEXT_PUBLIC_ prefix).
# ---------------------------------------------------------------------------

# JazzCash Mobile Wallet — https://sandbox.jazzcash.com.pk
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
JAZZCASH_MODE="sandbox"            # sandbox | production

# Easypaisa hosted checkout
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
EASYPAISA_ACCOUNT_NUMBER=""
EASYPAISA_MODE="sandbox"           # sandbox | production

# Card — Stripe-compatible hosted Checkout. PriceNova never touches card data.
CARD_PROVIDER_SECRET_KEY=""
CARD_PROVIDER_WEBHOOK_SECRET=""
CARD_PROVIDER_API_BASE="https://api.stripe.com/v1"
CARD_PROVIDER_MODE="sandbox"       # sandbox | production

# Crypto — NOWPayments-compatible gateway (BTC, USDT TRC20/ERC20).
# The gateway holds the keys and watches the chains. PriceNova holds none.
CRYPTO_PROVIDER_API_KEY=""
CRYPTO_PROVIDER_IPN_SECRET=""
CRYPTO_PROVIDER_API_BASE="https://api.nowpayments.io/v1"
CRYPTO_PROVIDER_MODE="sandbox"     # sandbox | production

# Confirmation targets. Operator policy; defaults are BTC 2, USDT 12.
CRYPTO_CONFIRMATIONS_BTC="2"
CRYPTO_CONFIRMATIONS_USDT_TRC20="12"
CRYPTO_CONFIRMATIONS_USDT_ERC20="12"

# How far under the asked-for amount still credits, in minor units (cents).
# 0 means an exact amount is required.
PAYMENT_UNDERPAY_TOLERANCE_MINOR="0"

# Optional transaction-inquiry endpoints. Left blank on purpose: whether a
# merchant gets a lookup API — and at what URL — depends on the agreement the
# provider grants. Without these, payments go to manual review rather than
# being verified against an invented endpoint.
JAZZCASH_INQUIRY_URL=""
EASYPAISA_INQUIRY_URL=""
